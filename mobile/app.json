{
  "expo": {
    "name": "Vox AI",
    "slug": "vox-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.voxai.assistant",
      "adaptiveIcon": {
        "backgroundColor": "#26272E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET"
      ],
      "usesCleartextTraffic": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Vox AI to access your microphone for voice assistant commands.",
          "speechRecognitionPermission": "Allow Vox AI to recognize your spoken speech."
        }
      ],
      "expo-font"
    ]
  }
}
