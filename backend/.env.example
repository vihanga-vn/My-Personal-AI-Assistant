# Server Configuration
PORT=5000

# Google Gemini API Key (Backend only - Free tier)
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=

# Gemini Model (Defaults to gemini-3.8-flash on free tier)
GEMINI_MODEL=gemini-3.8-flash

# MongoDB Atlas Connection String (Backend only - Free tier)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/personal_assistant?retryWrites=true&w=majority
MONGODB_URI=
